{
  "name": "@thehog/mcp",
  "version": "0.8.0",
  "description": "MCP server for The Hog API",
  "homepage": "https://docs.thehog.ai/guides/use-mcp",
  "bugs": {
    "url": "https://github.com/The-Hog/the-hog-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Hog/the-hog-mcp.git"
  },
  "keywords": [
    "thehog",
    "mcp",
    "model-context-protocol",
    "sales-intelligence",
    "prospecting"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "thehog-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && rm -rf dist-test && tsc -p tsconfig.spec.json && node scripts/run-tests.mjs",
    "test:live:mcp-grid": "RUN_LIVE_THEHOG_MCP_E2E=true sh -c 'tsc -p tsconfig.spec.json && node --test \"dist-test/live/**/*.live.spec.js\"'",
    "eval:mcp-tool-selection": "sh -c 'tsc -p tsconfig.spec.json && node --test \"dist-test/evals/tool-selection.eval.js\"'",
    "eval:mcp-semantics": "sh -c 'tsc -p tsconfig.spec.json && node --test \"dist-test/evals/semantic-result.eval.js\"'",
    "test:openapi": "tsc -p tsconfig.spec.json && THEHOG_RUN_OPENAPI_DRIFT=1 node --test \"dist-test/tools/primitives/openapi-drift.spec.js\"",
    "release:check": "npm test && npm run test:openapi && npm run pack:dry-run",
    "prepack": "npm test && npm run build",
    "prepublishOnly": "npm test && npm run test:openapi && npm run pack:dry-run",
    "pack:dry-run": "npm run build && npm pack --dry-run --ignore-scripts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": false
}
